{
  "name": "@sanity/locale-da-dk",
  "version": "1.0.32",
  "private": false,
  "description": "Danish / Dansk locale/translation for Sanity Studio",
  "keywords": [
    "da-DK",
    "i18n",
    "locale",
    "localization",
    "sanity"
  ],
  "homepage": "https://github.com/sanity-io/locales#readme",
  "bugs": {
    "url": "https://github.com/sanity-io/locales/issues"
  },
  "license": "MIT",
  "contributors": [
    {
      "name": "Kasper-Buchholtz",
      "url": "https://github.com/Kasper-Buchholtz"
    },
    {
      "name": "Kastholm",
      "url": "https://github.com/Kastholm"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/sanity-io/locales.git",
    "directory": "locales/da-DK"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "pkg build --strict --check",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "sanity": "^3.22.0 || ^4.0.0-0 || ^5.0.0-0 || ^6.0.0-0"
  },
  "browserslist": "extends @sanity/browserslist-config",
  "engines": {
    "node": ">=18"
  }
}
